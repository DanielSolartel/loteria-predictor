# Fase 9.1 - pasarela local (EJEMPLO SIN SECRETOS). Copiar a pasarela.privado.env, que Git ignora
# (*.privado.env), o definir las variables en la sesion. La clave en claro solo va aqui o en el entorno;
# la API publica guarda su huella en API_PUBLICA_CLAVES. Sin clave valida la pasarela responde 503.
# Arranque soportado, desde backend/:
# uvicorn app.pasarela.aplicacion:app --host 127.0.0.1 --port 8020 --no-access-log --no-proxy-headers
PASARELA_CLAVE_API=
PASARELA_API_URL=http://127.0.0.1:8010
PASARELA_HOSTS=127.0.0.1:8020,localhost:8020
PASARELA_ORIGENES=http://127.0.0.1:8020,http://localhost:8020
# Vacio: frontend/dist del repositorio.
PASARELA_DIST=
# Enlace opcional a la consola HTMX local (desactivado si esta vacio), p. ej. http://127.0.0.1:8000
PASARELA_CONSOLA_LOCAL=
