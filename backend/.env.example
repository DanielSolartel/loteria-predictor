DATABASE_URL=postgresql+psycopg://loteria:loteria@localhost:5432/loteria_predictor
ENVIRONMENT=development
MAX_PAGINAS_ABSOLUTO_CONECTORES=2000
# Fase 8 - API publica. Sin claves validas la API rechaza las consultas (503). Arranque soportado, desde backend/:
# uvicorn app.api.publica.aplicacion:app --host 127.0.0.1 --port 8010 --no-access-log --no-proxy-headers
# Entradas id:sha256:<huella>, generadas con: python -m scripts.api_publica_claves generar --id <id>
API_PUBLICA_CLAVES=
API_PUBLICA_FICHAS_POR_MINUTO=60
API_PUBLICA_FICHAS_POR_MINUTO_IP=120
API_PUBLICA_MAX_CLIENTES_IP=1024
API_PUBLICA_CORS_ORIGENES=
API_PUBLICA_DOCUMENTACION=true
