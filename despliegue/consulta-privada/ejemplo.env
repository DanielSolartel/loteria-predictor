# Fase 10 (E10.2): EJEMPLO de configuracion del perfil privado, SIN secretos. Los valores entre <...> los decide
# cada entorno (E10.5); las rutas /run/secretos/* son archivos montados en ejecucion, nunca variables.
# Proveedor, VPN, CA real, registro de imagenes y custodia de secretos siguen sin decidir.

# --- API publica: uvicorn app.api.publica.privada:app --host <IP interna> --port 8010 --workers 1 --no-access-log --no-proxy-headers
DATABASE_URL_ARCHIVO=/run/secretos/api_database_url          # postgresql+psycopg://consulta_lector:<...>@<IP base>:5432/<base>
API_PUBLICA_CLAVES_ARCHIVO=/run/secretos/api_claves          # una huella id:sha256:<64 hex> por linea (dos durante una rotacion)
API_PUBLICA_HOSTS=<IP interna de la API>:8010,127.0.0.1:8010
API_PUBLICA_CLIENTES=<IP de la pasarela>,127.0.0.1           # 127.0.0.1: comprobacion de salud del propio contenedor
API_PUBLICA_FICHAS_POR_MINUTO=1200                           # mayor que la cuota agregada de la pasarela
API_PUBLICA_FICHAS_POR_MINUTO_IP=2400
API_PUBLICA_DOCUMENTACION=false
API_PUBLICA_CONCURRENCIA_COSTOSAS=2
API_PUBLICA_ESPERA_COSTOSAS=0.5
BASE_TIEMPO_MAXIMO_CONSULTA_MS=1500
BASE_TIEMPO_MAXIMO_INACTIVA_MS=5000
BASE_POOL_TAMANO=4
BASE_POOL_DESBORDE=2
BASE_POOL_ESPERA_S=2
DIRECTORIO_LABORATORIO_MODELOS=/srv/pub/laboratorio
DIRECTORIO_CARTERAS_MODELOS=/srv/pub/carteras
DIRECTORIO_PREDICCIONES_MODELOS=/srv/pub/predicciones
DIRECTORIO_PRONOSTICOS_EXPERIMENTALES=/srv/pub/pronosticos
DIRECTORIO_RESULTADOS_MODELOS=/srv/sin-publicar/resultados   # no se publica (estado operativo)
DIRECTORIO_SIMULACIONES=/srv/sin-publicar/simulaciones

# --- Pasarela: PASARELA_PERFIL=privado, uvicorn app.pasarela.aplicacion:app --host <IP interna> --port 8020 --workers 1 --no-access-log --no-proxy-headers
PASARELA_PERFIL=privado
PASARELA_PROXIES_FIABLES=<IP exacta del proxy>
PASARELA_SECRETO_PROXY_ARCHIVO=/run/secretos/pasarela_ingreso
PASARELA_CLAVE_API_ARCHIVO=/run/secretos/pasarela_clave_api
PASARELA_API_URL=http://<IP interna de la API>:8010
PASARELA_HOSTS=<nombre interno de la consulta>:<puerto>
PASARELA_ORIGENES=https://<nombre interno de la consulta>:<puerto>
PASARELA_FICHAS_PERSONA_POR_MINUTO=30
PASARELA_FICHAS_AGREGADAS_POR_MINUTO=90
PASARELA_MAX_PERSONAS=64
# PASARELA_CLAVE_API y PASARELA_CONSOLA_LOCAL deben quedar vacias en este perfil.
